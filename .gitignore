# 工具与源码包（远程机器上由 01_setup_tools.sh 生成，不入库）
tools/

# 大文件测试数据（远程下载，只入库校验和）
workloads/silesia.tar
workloads/silesia.zip
workloads/*.bin

# fio 测试文件
*.fio.tmp
fio-test-*

# 测试结果中的文本、JSON、CSV 和图表允许入库，便于跨平台汇总与追溯。
# 仅排除不适合进入普通 Git 历史的大型二进制或归档产物。
results/raw/**/*.tar
results/raw/**/*.tar.gz
results/raw/**/*.tgz
results/raw/**/*.img
results/raw/**/*.bin
results/raw/**/perf.data*

# 杂项
.DS_Store
__pycache__/
